	"authors": [
		"Flix100000",
		"PixlStudios"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/history-stages",
		"sources": "https://github.com/Flix100000/History-Stages"
	},
	"license": "GPL-3.0",
	"environment": "*",
