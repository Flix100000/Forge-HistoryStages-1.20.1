	"mixins": [
		"historystages.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"lootr": "*"
	},
	"suggests": {
		"jade": "*",
		"emi": "*",
