			"net.bananemdnsa.historystages.HistoryStagesFabric"
		],
		"client": [
			"net.bananemdnsa.historystages.client.HistoryStagesFabricClient"
		],
		"jei_mod_plugin": [
			"net.bananemdnsa.historystages.jei.JEIPlugin"
		],
		"emi": [
			"net.bananemdnsa.historystages.emi.EMIPlugin"
		],
		"ftbquests": [
